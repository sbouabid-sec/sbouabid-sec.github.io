---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { publishedPosts } from '../lib/content';
const published = await publishedPosts();
const latest = published.slice(0, 5);
const writeupCount = published.filter((post) => post.data.type === 'writeup' && !post.data.sample).length;
const sections = [
  ['01', 'Writeups', '/writeups/', 'Walkthroughs and learning notes'],
  ['02', 'Research', '/research/', 'Security investigations and reports'],
  ['03', 'Blog', '/blog/', 'Tools, methods, and other writing'],
  ['04', 'Projects', '/projects/', 'Things built and maintained'],
];
---

<BaseLayout title="Soulaimane Bouabid — Security Portfolio" description="Portfolio of Soulaimane Bouabid, a penetration testing intern. Explore writeups, research, blog posts, and projects.">
  <section class="hero container">
    <div>
      <p class="eyebrow">PORTFOLIO / OFFENSIVE SECURITY</p>
      <h1>Soulaimane<br /><span class="accent">Bouabid.</span></h1>
      <p class="role">Penetration testing intern</p>
      <p class="status">Preparing for CRTP and writing up HackTheBox machines.</p>
    </div>
    <div class="hero-aside">
      <span class="eyebrow">WHAT'S HERE</span>
      <p>{writeupCount} {writeupCount === 1 ? 'writeup' : 'writeups'} across HackTheBox, VulnLab, and web security.</p>
    </div>
  </section>

  <section class="section-block container" aria-labelledby="about-heading">
    <div class="section-heading"><h2 id="about-heading">About</h2><span>01 / INTRODUCTION</span></div>
    <div class="about-grid">
      <p>I'm Soulaimane, a penetration testing intern focused on Active Directory and web application security.</p>
      <p class="about-notes">I write up what I break, end to end: the path, the commands, and why it worked.</p>
    </div>
  </section>

  <section class="proof-band" aria-labelledby="proof-heading">
    <div class="container">
      <div class="section-heading"><h2 id="proof-heading">Proof points</h2><span>02 / VERIFIED FACTS</span></div>
      <div class="proof-grid">
        <!-- Update the machine count and date by hand when it changes. -->
        <div class="proof-item"><span class="eyebrow">HACKTHEBOX</span><strong>Pro Hacker</strong><p>54 machines owned (Oct 2026)</p></div>
        <div class="proof-item"><span class="eyebrow">EDUCATION</span><strong>1337 Coding School</strong><p>Part of the 42 Network</p></div>
        <!-- Findings reference for a future Findings list: GHSA-2j8v-xx77-v45j, GHSA-mrg5-rhfq-9wvf, GHSA-39rr-47j5-8qfv, CVE-2026-5038. Two more CVEs are pending a number. Update the count and the text by hand when one is published. -->
        <div class="proof-item"><span class="eyebrow">FINDINGS</span><strong>4 published advisories</strong><p>3 GHSA, 1 CVE · 2 more CVEs pending</p></div>
      </div>
    </div>
  </section>

  <section class="section-block container" aria-labelledby="links-heading">
    <div class="section-heading"><h2 id="links-heading">Find me</h2><span>03 / LINKS</span></div>
    <div class="link-grid">
      <a href="https://github.com/sbouabid-sec" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile, sbouabid-sec (opens in a new tab)"><strong><i class="link-icon" aria-hidden="true">&#123;&#125;</i> GitHub</strong><span>github.com/sbouabid-sec <b class="arrow">↗</b></span></a>
      <a href="https://app.hackthebox.com/users/2737090" target="_blank" rel="noopener noreferrer" aria-label="HackTheBox profile, 0xAlexx (opens in a new tab)"><strong><i class="link-icon" aria-hidden="true">⬡</i> HackTheBox</strong><span>0xAlexx <b class="arrow">↗</b></span></a>
      <a href="https://www.linkedin.com/in/sbouabid" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile, sbouabid (opens in a new tab)"><strong><i class="link-icon" aria-hidden="true">in</i> LinkedIn</strong><span>linkedin.com/in/sbouabid <b class="arrow">↗</b></span></a>
      <a href="mailto:soulaimane.bouabid.sec@gmail.com" aria-label="Contact me by email at soulaimane.bouabid.sec@gmail.com"><strong><i class="link-icon" aria-hidden="true">@</i> Contact me</strong><span>soulaimane.bouabid.sec@gmail.com <b class="arrow">↗</b></span></a>
    </div>
  </section>

  <section class="section-block container" aria-labelledby="explore-heading">
    <div class="section-heading"><h2 id="explore-heading">Explore the work</h2><span>04 / SECTIONS</span></div>
    <div class="section-links">{sections.map(([number, label, href, summary]) => <a href={href}><span>{number} / {summary}</span><strong>{label} <b class="arrow">↗</b></strong></a>)}</div>
  </section>

  <section class="section-block container" aria-labelledby="latest-heading">
    <div class="section-heading"><h2 id="latest-heading">Latest posts</h2><span>05 / NEWEST FIRST</span></div>
    <div class="latest-list">{latest.map((post) => <PostRow post={post} />)}</div>
  </section>
</BaseLayout>
