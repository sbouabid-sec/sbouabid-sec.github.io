---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingPage from '../../components/ListingPage.astro';
import { publishedPosts } from '../../lib/content';
const posts = (await publishedPosts()).filter((post) => post.data.type === 'research');
---
<BaseLayout title="Research | Soulaimane Bouabid" description="Security research and investigation reports from Soulaimane Bouabid. Current entries are clearly labeled SAMPLE.">
  <ListingPage eyebrow="02 / ARCHIVE" title="Research" intro="Security research, investigations, and findings. SAMPLE entries are demonstrations only." posts={posts} />
</BaseLayout>
