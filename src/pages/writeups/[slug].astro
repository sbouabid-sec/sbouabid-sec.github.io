---
import type { CollectionEntry } from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';
import { publishedPosts } from '../../lib/content';
import { postSlug } from '../../lib/posts.mjs';
export async function getStaticPaths() {
  return (await publishedPosts()).filter((post) => post.data.type === 'writeup').map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}
const { post } = Astro.props as { post: CollectionEntry<'posts'> };
---
<ArticlePage post={post} />
